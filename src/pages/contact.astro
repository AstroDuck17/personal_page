---
import Base from '../layouts/Base.astro';
import { resume } from '../data/resume';
---
<Base title="Contact"><section class="wrap page-intro"><h1>Contact</h1><p>You can reach me by email or find my work on GitHub.</p><div class="contact-options"><a class="button" href={`mailto:${resume.email}`}>Email me ↗</a><a class="text-link" href={resume.github}>GitHub ↗</a><a class="text-link" href={resume.linkedin}>LinkedIn ↗</a></div><p class="contact-email">{resume.email}</p></section></Base>
