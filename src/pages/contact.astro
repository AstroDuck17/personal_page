---
import Base from '../layouts/Base.astro';
import { resume } from '../data/resume';
---
<Base title="Contact"><section class="wrap page-intro"><h1>Say hello.</h1><p>Have a question about a project, or something interesting to share? I’d be happy to hear from you.</p><div class="contact-options"><a class="button" href={`mailto:${resume.email}`}>Write me an email ↗</a><a class="text-link" href={resume.github}>GitHub ↗</a><a class="text-link" href={resume.linkedin}>LinkedIn ↗</a></div><p class="contact-email">{resume.email}</p></section></Base>
