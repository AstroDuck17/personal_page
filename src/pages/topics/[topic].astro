---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import WritingList from '../../components/WritingList.astro';
import { projects, writing, href } from '../../lib/content';
import { topics } from '../../data/topics';
export function getStaticPaths() { return Object.entries(topics).map(([topic,data])=>({params:{topic},props:{topic,...data}})); }
interface Props { topic:string; name:string; description:string; }
const { topic, name, description } = Astro.props;
const work = (await projects()).filter(p=>p.data.topics.some(id=>id === topic));
const notes = (await writing()).filter(p=>p.data.topics.some(id=>id === topic));
---
<Base title={name} description={description}><div class="wrap"><header class="page-intro topic-intro"><a class="text-link" href={href('projects/')}>← Explore the work</a><p class="eyebrow">A THREAD THROUGH THE SITE</p><h1>{name}<span class="olive" aria-hidden="true">.</span></h1><p>{description}</p></header>{work.length>0 && <section class="section"><div class="section-heading"><h2>Projects & research</h2><span class="eyebrow">{work.length} ENTRIES</span></div><div class="project-grid">{work.map((entry,index)=><ProjectCard entry={entry} index={index+1} />)}</div></section>}{notes.length>0 && <section class="section"><h2>From the notebook</h2><WritingList entries={notes} /></section>}{work.length===0 && notes.length===0 && <aside class="topic-placeholder"><span aria-hidden="true">✳</span><h2>A beginning, with room to grow.</h2><p>This collection will bring together projects and writing with the same topic label. For now, it marks a direction I’m interested in exploring.</p><a class="text-link" href={href('writing/')}>Visit the notebook →</a></aside>}</div></Base>
