---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Topics from '../../components/Topics.astro';
import { writing, projects, href, projectUrl, writingUrl, formatDate } from '../../lib/content';
export async function getStaticPaths() { return (await writing()).map(entry=>({params:{id:entry.id},props:{entry}})); }
interface Props { entry: CollectionEntry<'writing'>; }
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const relatedProjects = (await projects()).filter(item=>d.related.includes(item.id));
const relatedWriting = (await writing()).filter(item=>d.related.includes(item.id));
---
<Base title={d.title} description={d.description} active="Articles & Notes" noindex={d.draft}><article class="wrap writing-article"><a class="text-link" href={href('writing/')}>← Articles & notes</a><header class="article-header"><p class="eyebrow">{d.draft ? 'UNPUBLISHED REVIEW DRAFT' : d.type.toUpperCase().replaceAll('-',' ')} · {d.readingTime}{d.date ? ` · ${formatDate(d.date)}` : ''}</p><h1>{d.title}</h1><p class="case-description">{d.description}</p><Topics topics={d.topics} /></header>{d.editorialNote && <aside class="editorial-note"><strong>Editorial note</strong><p>{d.editorialNote}</p></aside>}<div class="article-layout">{headings.length>0 && <nav class="article-toc" aria-label="On this page"><p class="eyebrow">IN THIS NOTE</p>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav>}<div class="prose"><Content /></div></div>{(relatedProjects.length>0 || relatedWriting.length>0) && <aside class="related-section"><p class="eyebrow">CONNECTED WORK</p>{relatedProjects.map(p=><a class="related-link" href={projectUrl(p.id)}>{p.data.title} ↗</a>)}{relatedWriting.map(p=><a class="related-link" href={writingUrl(p.id)}>{p.data.title} ↗</a>)}</aside>}</article></Base>
