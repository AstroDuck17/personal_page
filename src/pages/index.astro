---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingList from '../components/WritingList.astro';
import { projects, writing, href, topicUrl } from '../lib/content';
const selected = (await projects()).filter(p=>p.data.featured).slice(0,2);
const notes = (await writing()).filter(p=>p.data.featured);
---
<Base active="Home">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow">B.TECH CSE · IIIT HYDERABAD</p>
      <h1>Hi, I’m <em>Yashav.</em></h1>
      <p class="hero-intro">I’m a computer science student at IIIT Hyderabad. I like working through unfamiliar ideas and seeing what I can build with them.</p>
      <p class="hero-intro">Right now, I’m studying video representations at Precog and starting to explore quantum computing. Here you’ll find my projects, with room for notes on what I’m learning along the way.</p>
      <div class="hero-actions"><a class="button" href={href('projects/')}>Take a look around <span aria-hidden="true">↗</span></a><a class="text-link" href={href('resume/')}>My résumé →</a></div>
    </div>
    <aside class="hero-aside"><div class="portrait-frame"><img src={href('images/Profilepic.jpg')} alt="Yashav Bhatnagar" width="310" height="380" fetchpriority="high" /></div></aside>
  </section>
  <div class="interest-band"><div class="wrap interest-inner"><span class="eyebrow">INTERESTS</span><a href={topicUrl('machine-learning')}>Machine learning</a><span aria-hidden="true">✳</span><a href={topicUrl('systems')}>Systems</a><span aria-hidden="true">✳</span><a href={topicUrl('embedded')}>Embedded</a><span aria-hidden="true">✳</span><a href={topicUrl('quantum-computing')}>Quantum computing ↗</a></div></div>
  <section class="wrap section"><div class="section-heading"><h2>Some of my work</h2><a class="text-link" href={href('projects/')}>All projects & research ↗</a></div><div class="project-grid">{selected.map((entry,index)=><ProjectCard entry={entry} index={index+1} />)}</div></section>
  <section class="wrap section curiosity-section"><h2>Getting into<br /><em>quantum computing.</em></h2><div><p>I’m starting with the foundations and want to keep a record of what I learn. If you’re exploring this too, you can follow along here.</p><a class="text-link" href={topicUrl('quantum-computing')}>Follow along ↗</a></div></section>
  <section class="wrap section home-writing"><div class="section-heading"><h2>From my notebook</h2><a class="text-link" href={href('writing/')}>Articles & notes ↗</a></div><WritingList entries={notes} /></section>
  <section class="wrap personal-section" aria-label="Away from the keyboard">
    <details class="personal-details">
      <summary><h2 class="personal-title">Away from the keyboard</h2><span class="disclosure-icon" aria-hidden="true">+</span></summary>
      <div class="personal-interests">
        <div><h3>Piano</h3><p>Some time at the piano makes a nice change from a screen.</p></div>
        <div><h3>Drawing</h3><p>I like sketching and trying out different styles. There’s always more to practice.</p></div>
        <div><h3>Travel</h3><p>I enjoy seeing new places and having a look around.</p></div>
      </div>
    </details>
  </section>
</Base>
