---
import Base from '../../layouts/Base.astro';
import { resume } from '../../data/resume';
import { href } from '../../lib/content';
---
<Base title="Résumé" active="Résumé"><div class="wrap resume-layout"><aside class="resume-sidebar"><div class="resume-identity"><img src={href('images/Profilepic.jpg')} alt="Yashav Bhatnagar" width="90" height="90" /><h1>{resume.name}</h1><p>{resume.title}</p></div><div class="resume-contact"><span class="eyebrow">CONTACT</span><a href={`mailto:${resume.email}`}>Email ↗</a><a href={resume.github}>GitHub ↗</a><a href={resume.linkedin}>LinkedIn ↗</a></div><a class="button" href={href('cv.pdf')} download="Yashav_Bhatnagar_CV.pdf">Download CV <span aria-hidden="true">↓</span></a><p class="resume-snapshot">CV snapshot<br />{resume.snapshot}<br />PDF · original source</p><a href="#education" class="text-link">Education ↓</a><a href="#experience" class="text-link">Experience ↓</a><a href="#skills" class="text-link">Skills ↓</a></aside><div class="resume-main"><header class="resume-intro"><p class="eyebrow">EDUCATION & EXPERIENCE</p><h2>Résumé</h2><p>Computer science at IIIT Hyderabad, with experience across research, software engineering, and embedded systems.</p></header><section id="education" class="resume-section"><h2>Education</h2><div class="resume-row"><div class="resume-row-title"><h3>{resume.education.institution}</h3><span>{resume.education.period}</span></div><p>{resume.education.degree}</p><p class="resume-muted">{resume.education.grade} · {resume.snapshot} snapshot</p><p class="coursework"><strong>Coursework & study</strong><br />{resume.education.coursework.join(' · ')}</p></div></section><section id="experience" class="resume-section"><h2>Experience</h2>{resume.experience.map(job=><article class="resume-row"><div class="resume-row-title"><h3>{job.organization}</h3><span>{job.period}</span></div><p class="job-role">{job.role}</p><ul>{job.bullets.map(b=><li>{b}</li>)}</ul></article>)}</section><section id="skills" class="resume-section"><h2>Tools I’ve worked with</h2>{resume.skills.map(group=><div class="skill-group"><h3>{group.label}</h3><div class="skill-tags">{group.items.map(skill=><span>{skill}</span>)}</div></div>)}</section><section class="resume-section"><h2>Achievements</h2><ul>{resume.achievements.map(item=><li>{item}</li>)}</ul></section><p class="resume-source-note">Based on the {resume.snapshot} CV. <a href={href('cv.pdf')}>Open the source PDF ↗</a></p></div></div></Base>
