---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Topics from '../../components/Topics.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects, writing, href, writingUrl, projectUrl } from '../../lib/content';
export async function getStaticPaths() { return (await projects()).map(entry=>({ params:{id:entry.id}, props:{entry} })); }
interface Props { entry: CollectionEntry<'projects'>; }
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const relatedWriting = (await writing()).filter(item=>d.related.includes(item.id) || item.data.related.includes(entry.id));
const relatedProjects = (await projects()).filter(item=>d.related.includes(item.id));
---
<Base title={d.title} description={d.description} active="Projects & Research" noindex={d.draft}>
  <article class="wrap case-study"><nav class="case-nav" aria-label="Project sections"><a href={href('projects/')}>← All work</a><div>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</div></nav>
    <header class="case-header"><p class="eyebrow">{d.type.toUpperCase()} / {d.status.toUpperCase()}{d.dateLabel && ` / ${d.dateLabel}`}</p><h1>{d.title}</h1><p class="case-description">{d.description}</p><Topics topics={d.topics} /></header>
    <ProjectVisual kind={d.visual} large />
    <dl class="case-facts"><div><dt>My role</dt><dd>{d.role}</dd></div><div><dt>Context</dt><dd>{d.context}</dd></div><div><dt>Built with</dt><dd>{d.stack.join(' · ')}</dd></div></dl>
    {d.links.length > 0 && <div class="case-links">{d.links.map(link=><a class="button button-outline" href={link.url}>{link.label} ↗</a>)}</div>}
    <div class="prose"><Content /></div>
    {(relatedWriting.length > 0 || relatedProjects.length > 0) && <aside class="related-section"><p class="eyebrow">RELATED WORK</p>{relatedWriting.map(item=><a class="related-link" href={writingUrl(item.id)}>{item.data.title} {item.data.draft && '(review draft)'} ↗</a>)}{relatedProjects.map(item=><a class="related-link" href={projectUrl(item.id)}>{item.data.title} ↗</a>)}</aside>}
    <a class="text-link back-bottom" href={href('projects/')}>← Back to projects & research</a>
  </article>
</Base>
