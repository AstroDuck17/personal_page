---
import type { CollectionEntry } from 'astro:content';
import { writingUrl, formatDate } from '../lib/content';
import Topics from './Topics.astro';
interface Props { entries: CollectionEntry<'writing'>[]; headingLevel?: 'h2' | 'h3'; }
const { entries, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---
{entries.length ? <div class="writing-list">{entries.map(entry => <article class="writing-row"><div class="writing-type">{entry.data.draft ? 'Draft note' : entry.data.type.replaceAll('-', ' ')}<span>{entry.data.readingTime}</span></div><div><Heading><a href={writingUrl(entry.id)}>{entry.data.title} <span aria-hidden="true">↗</span></a></Heading><p>{entry.data.description}</p><Topics topics={entry.data.topics} /></div><span class="writing-date">{entry.data.date ? formatDate(entry.data.date) : entry.data.dateLabel}</span></article>)}</div> : <div class="empty-writing"><span class="eyebrow">WRITING</span><Heading>Nothing published yet.</Heading><p>I’ll add articles and notes here as they’re ready.</p></div>}
