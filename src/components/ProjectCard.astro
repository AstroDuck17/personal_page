---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
import Topics from './Topics.astro';
import { projectUrl } from '../lib/content';
interface Props { entry: CollectionEntry<'projects'>; index?: number; }
const { entry, index = 1 } = Astro.props;
const d = entry.data;
const status = { completed: 'Built', ongoing: 'Ongoing', planned: 'Planned', draft: 'Draft' };
---
<article class="project-card" data-topics={d.topics.join(' ')} data-type={d.type}>
  <a href={projectUrl(entry.id)} class="project-cover" aria-label={`Read ${d.title}`}><ProjectVisual kind={d.visual} /><span class="cover-number">{String(index).padStart(2,'0')}</span><span class="cover-open" aria-hidden="true">↗</span></a>
  <div class="card-meta"><span>{d.type === 'research' ? 'Research' : 'Project'} · {status[d.status]}</span>{d.dateLabel && <span>{d.dateLabel}</span>}</div>
  <h3><a href={projectUrl(entry.id)}>{d.title}</a></h3>
  <p>{d.description}</p>
  <Topics topics={d.topics} />
</article>
