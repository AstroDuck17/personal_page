---
interface Props { kind: string; large?: boolean; }
const { kind, large = false } = Astro.props;
---
<div class:list={['project-visual', `visual-${kind}`, { 'visual-large': large }]} aria-hidden="true">
  <svg viewBox="0 0 600 330" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <defs><pattern id={`grid-${kind}`} width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="currentColor" opacity=".18" /></pattern></defs>
    <rect width="600" height="330" fill={`url(#grid-${kind})`} />
    {kind === 'hardware' ? <>
      <path d="M170 110H250M170 165H250M170 220H250M350 165H440" class="wire" />
      {[['CLI',110],['DESKTOP',165],['BROWSER',220]].map(([s,y]) => <><rect x="62" y={Number(y)-20} width="108" height="40" rx="8" class="diagram-box" /><text x="116" y={Number(y)+5} class="diagram-text">{s}</text></>)}
      <rect x="250" y="108" width="100" height="114" rx="12" class="diagram-solid" /><text x="300" y="152" class="diagram-text inverse">DEVICE</text><text x="300" y="175" class="diagram-text inverse">LAYER</text>
      <rect x="440" y="130" width="105" height="70" rx="8" class="diagram-box" /><text x="492" y="159" class="diagram-text">RASPBERRY</text><text x="492" y="180" class="diagram-text">PI + SENSORS</text>
      <text x="300" y="281" class="diagram-label">THREE INTERFACES. ONE HARDWARE LAYER.</text>
    </> : kind === 'physics' ? <>
      {[0,1,2,3].map((i) => <><rect x={64+i*124} y="80" width="100" height="122" rx="8" class="diagram-box" /><path d={`M${74+i*124} 178h80`} class="wire" /><circle cx={90+i*135} cy={150-i*13} r="14" class="diagram-solid" /><text x={114+i*124} y="226" class="diagram-text">t{i ? ` + ${i}` : ''}</text></>)}
      <path d="M104 255H500m-12-8 12 8-12 8" class="wire" /><text x="300" y="294" class="diagram-label">WHAT DOES A VIDEO REPRESENTATION REMEMBER?</text>
    </> : kind === 'graph' || kind === 'orbit' ? <>
      <g class="wire"><path d="M170 95 300 160 430 90M170 95 130 220 300 160 445 235 430 90M300 160 290 275M130 220 290 275 445 235" /><path d="M170 95 445 235" stroke-dasharray="7 7" /></g>
      {[[170,95],[300,160],[430,90],[130,220],[445,235],[290,275]].map(([x,y],i) => <><circle cx={x} cy={y} r={i===1 ? 32 : 22} class={i===1 ? 'diagram-solid' : 'diagram-box'} /><text x={x} y={y+5} class:list={['diagram-text', { inverse: i===1 }]}>{kind==='orbit' ? ['ASSET','CONTEXT','THREAT','PII','ANALYST','ACTION'][i] : ['A','B','C','D','E','F'][i]}</text></>)}
      <text x="300" y="39" class="diagram-label">{kind === 'orbit' ? 'CONNECT THE CONTEXT. KEEP A HUMAN IN THE LOOP.' : 'RELATIONSHIPS, REPRESENTATIONS & MISSING LINKS'}</text>
    </> : kind === 'audio' ? <>
      {Array.from({length:21},(_,i) => <rect x={70+i*11} y={165-(10+Math.abs(Math.sin(i*1.3))*55)} width="5" height={20+Math.abs(Math.sin(i*1.3))*110} rx="2.5" class="diagram-solid" />)}
      <path d="M315 165h40m-10-7 10 7-10 7" class="wire" /><rect x="375" y="105" width="135" height="120" rx="16" class="diagram-box" /><text x="443" y="155" class="diagram-text">ESP32-S3</text><text x="443" y="180" class="diagram-text">INT8 · CNN</text><text x="300" y="282" class="diagram-label">LISTEN → RECOGNIZE → MOVE</text>
    </> : kind === 'shell' ? <>
      <rect x="80" y="64" width="440" height="202" rx="12" class="diagram-solid" /><g fill="#F2E8B8">{[105,123,141].map(x=><circle cx={x} cy="86" r="3" />)}</g><text x="110" y="137" class="terminal-text">$ cat questions.txt | sort</text><text x="110" y="174" class="terminal-text muted-terminal">fork → pipe → exec → wait</text><text x="110" y="218" class="terminal-text">$ <tspan class="cursor">_</tspan></text>
    </> : kind === 'kernel' ? <>
      <rect x="90" y="70" width="420" height="55" rx="8" class="diagram-box" /><text x="300" y="104" class="diagram-text">PROCESSES · SCHEDULING</text><rect x="90" y="138" width="420" height="55" rx="8" class="diagram-solid" /><text x="300" y="172" class="diagram-text inverse">xv6 · RISCV KERNEL</text><rect x="90" y="206" width="200" height="55" rx="8" class="diagram-box" /><text x="190" y="240" class="diagram-text">MEMORY</text><rect x="310" y="206" width="200" height="55" rx="8" class="diagram-box" /><text x="410" y="240" class="diagram-text">DISK SWAP</text>
    </> : <>
      <rect x="220" y="64" width="160" height="60" rx="8" class="diagram-solid" /><text x="300" y="100" class="diagram-text inverse">NAME SERVER</text><path d="M300 124v47H130v33m170-33v33m0-33h170v33" class="wire" />{[130,300,470].map((x,i)=><><rect x={x-65} y="204" width="130" height="63" rx="8" class="diagram-box" /><text x={x} y="242" class="diagram-text">STORAGE {i+1}</text></>)}
    </>}
  </svg>
  <span class="visual-caption">Conceptual diagram</span>
</div>
